[Unit]
Description=Zukunftswerkstatt process prototype
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claims-ai
Group=claims-ai
WorkingDirectory=/opt/claims-ai-portfolio/current
EnvironmentFile=/etc/claims-ai-portfolio.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3210
Environment=HOME=/var/lib/claims-ai
Environment=AI_PROVIDER=codex-cli
Environment=CLAUDE_CONFIG_DIR=/var/lib/claims-ai/.claude
Environment=CLAIMS_AI_DEFAULTS_DIR=/opt/claims-ai-portfolio/current/defaults
Environment=AI_UPLOAD_ROOT=/var/lib/claims-ai/workspace/process-captures
Environment=AI_SANDBOX_SETTINGS=/opt/claims-ai-portfolio/current/deploy/pi/sandbox-settings.json
Environment=PUBLIC_SITE_INFORMATION_PATH=/var/lib/claims-ai/public-site-information.json
Environment=PATH=/opt/claims-ai-portfolio/current/node_modules/.bin:/var/lib/claims-ai/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/install -d -m 700 /tmp/claude
ExecStart=/var/lib/claims-ai/.bun/bin/bun apps/server/src/index.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
ReadWritePaths=/var/lib/claims-ai
TasksMax=128
MemoryMax=2G

[Install]
WantedBy=multi-user.target
