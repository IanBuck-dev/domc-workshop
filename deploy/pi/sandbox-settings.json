{
  "network": {
    "allowedDomains": [
      "api.anthropic.com",
      "*.anthropic.com",
      "claude.ai",
      "*.claude.ai",
      "platform.claude.com"
    ],
    "deniedDomains": [],
    "allowUnixSockets": [],
    "allowLocalBinding": false
  },
  "filesystem": {
    "denyRead": [
      "/home",
      "/root",
      "/etc/claims-ai-portfolio.env",
      "/opt/claims-ai-portfolio",
      "/var/lib/claims-ai/workspace"
    ],
    "allowRead": [
      ".",
      "/var/lib/claims-ai/.claude",
      "/opt/claims-ai-portfolio/current/node_modules/@anthropic-ai/sandbox-runtime"
    ],
    "allowWrite": [".", "/tmp/claude", "/var/lib/claims-ai/.claude"],
    "denyWrite": []
  },
  "mandatoryDenySearchDepth": 5,
  "seccomp": {
    "applyPath": "/opt/claims-ai-portfolio/current/node_modules/@anthropic-ai/sandbox-runtime/vendor/seccomp/arm64/apply-seccomp"
  },
  "enableWeakerNestedSandbox": false,
  "enableWeakerNetworkIsolation": false
}
