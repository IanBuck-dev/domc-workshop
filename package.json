{
  "name": "claims-ai-portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build-release.ts web",
    "build:release": "bun run scripts/build-release.ts release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.30",
    "@anthropic-ai/sandbox-runtime": "0.0.66",
    "@fontsource-variable/open-sans": "^5.2.7",
    "@hono/node-server": "^1.19.1",
    "@tailwindcss/vite": "^4.1.14",
    "ai": "7.0.28",
    "ai-sdk-provider-claude-code": "4.0.1",
    "fflate": "^0.8.2",
    "hono": "^4.9.8",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.9.3",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
