{
  "name": "claims-ai-portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:local-no-sandbox": "bun run scripts/dev.ts --without-ai-sandbox",
    "build": "bun run scripts/build-release.ts web",
    "build:release": "bun run scripts/build-release.ts release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "bun test",
    "icons": "bun run scripts/generate-icons.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.51",
    "@anthropic-ai/sandbox-runtime": "0.0.66",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^1.19.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@shadcn/react": "0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "12.11.2",
    "ai": "7.0.48",
    "ai-sdk-provider-claude-code": "4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.2",
    "hono": "^4.9.8",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
