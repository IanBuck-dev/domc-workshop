{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims-ai/process-understanding/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "trigger",
    "outcome",
    "boundaries",
    "participants",
    "informationSources",
    "systems",
    "decisions",
    "controls",
    "handoffs",
    "volumeAndTime",
    "painPoints",
    "improvementGoals",
    "steps",
    "evidence",
    "documentCoverage",
    "knowledgeGaps",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "purpose": { "$ref": "#/$defs/stringFact" },
    "trigger": { "$ref": "#/$defs/stringFact" },
    "outcome": { "$ref": "#/$defs/stringFact" },
    "boundaries": { "$ref": "#/$defs/stringFact" },
    "participants": { "$ref": "#/$defs/listFact" },
    "informationSources": { "$ref": "#/$defs/listFact" },
    "systems": { "$ref": "#/$defs/listFact" },
    "decisions": { "$ref": "#/$defs/listFact" },
    "controls": { "$ref": "#/$defs/listFact" },
    "handoffs": { "$ref": "#/$defs/listFact" },
    "volumeAndTime": { "$ref": "#/$defs/listFact" },
    "painPoints": { "$ref": "#/$defs/listFact" },
    "improvementGoals": { "$ref": "#/$defs/listFact" },
    "steps": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/step" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 250,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "documentCoverage": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/coverage" }
    },
    "knowledgeGaps": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": [
        "user_stated",
        "file_evidence",
        "ai_structured",
        "ai_inferred",
        "user_confirmed",
        "unknown"
      ]
    },
    "confidence": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 100 },
        { "type": "null" }
      ]
    },
    "stringFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance",
        "evidenceIds",
        "confidence",
        "assumptions",
        "confirmed"
      ],
      "properties": {
        "value": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 12000 },
            { "type": "null" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidenceIds": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "confirmed": { "type": "boolean" }
      }
    },
    "listFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance",
        "evidenceIds",
        "confidence",
        "assumptions",
        "confirmed"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            { "type": "null" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidenceIds": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "confirmed": { "type": "boolean" }
      }
    },
    "informationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "type", "typeDetail"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "system_field",
            "email",
            "spreadsheet",
            "document",
            "image_or_scan",
            "free_text",
            "database_or_report",
            "other",
            "unknown"
          ]
        },
        "typeDetail": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 200 },
            { "type": "null" }
          ]
        }
      }
    },
    "decisionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "determination", "consequence", "nextStepId"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "determination": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        },
        "consequence": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        },
        "nextStepId": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 120 },
            { "type": "null" }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "mode", "options"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "mode": {
          "type": "string",
          "enum": ["rule_based", "professional_judgement", "mixed", "unknown"]
        },
        "options": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/decisionOption" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "name",
        "activity",
        "inputs",
        "outputs",
        "informationItems",
        "decisions",
        "miscellaneous",
        "provenance",
        "evidenceIds",
        "confidence",
        "assumptions",
        "confirmed"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "order": { "type": "integer", "minimum": 1, "maximum": 8 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "activity": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "inputs": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "outputs": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "informationItems": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/informationItem" }
        },
        "decisions": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/decision" }
        },
        "miscellaneous": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 4000 },
            { "type": "null" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidenceIds": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "confirmed": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceId", "excerpt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": {
          "type": "string",
          "enum": ["main_answer", "follow_up_answer", "upload"]
        },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploadId",
        "name",
        "status",
        "processedCharacters",
        "limitation"
      ],
      "properties": {
        "uploadId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed"]
        },
        "processedCharacters": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "limitation": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
