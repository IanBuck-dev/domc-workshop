{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims-ai/process-understanding/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "trigger",
    "outcome",
    "boundaries",
    "participants",
    "informationSources",
    "systems",
    "controls",
    "handoffs",
    "volumeAndTime",
    "painPoints",
    "improvementGoals",
    "steps",
    "evidence",
    "documentCoverage",
    "knowledgeGaps",
    "conflicts",
    "flow"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "purpose": { "$ref": "#/$defs/stringFact" },
    "trigger": { "$ref": "#/$defs/stringFact" },
    "outcome": { "$ref": "#/$defs/stringFact" },
    "boundaries": { "$ref": "#/$defs/stringFact" },
    "participants": { "$ref": "#/$defs/listFact" },
    "informationSources": { "$ref": "#/$defs/listFact" },
    "systems": { "$ref": "#/$defs/listFact" },
    "controls": { "$ref": "#/$defs/listFact" },
    "handoffs": { "$ref": "#/$defs/listFact" },
    "volumeAndTime": { "$ref": "#/$defs/listFact" },
    "painPoints": { "$ref": "#/$defs/listFact" },
    "improvementGoals": { "$ref": "#/$defs/listFact" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/step" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 250,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "documentCoverage": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/coverage" }
    },
    "knowledgeGaps": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "flow": { "$ref": "#/$defs/flow" }
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": [
        "user_stated",
        "file_evidence",
        "ai_structured",
        "ai_inferred",
        "user_confirmed",
        "unknown"
      ]
    },
    "confidence": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 100 },
        { "type": "null" }
      ]
    },
    "stringFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance",
        "evidenceIds",
        "confidence",
        "assumptions",
        "confirmed"
      ],
      "properties": {
        "value": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 12000 },
            { "type": "null" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidenceIds": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "confirmed": { "type": "boolean" }
      }
    },
    "listFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance",
        "evidenceIds",
        "confidence",
        "assumptions",
        "confirmed"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            { "type": "null" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidenceIds": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "confirmed": { "type": "boolean" }
      }
    },
    "informationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "type", "typeDetail"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "system_field",
            "email",
            "spreadsheet",
            "document",
            "image_or_scan",
            "free_text",
            "database_or_report",
            "other",
            "unknown"
          ]
        },
        "typeDetail": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 200 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "other" } } },
          "else": { "properties": { "typeDetail": { "type": "null" } } }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "name",
        "activity",
        "inputs",
        "outputs",
        "informationItems",
        "miscellaneous",
        "provenance",
        "evidenceIds",
        "confidence",
        "assumptions",
        "confirmed"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "order": { "type": "integer", "minimum": 1, "maximum": 8 },
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "activity": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "inputs": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "outputs": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "informationItems": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/informationItem" }
        },
        "miscellaneous": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 4000 },
            { "type": "null" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "evidenceIds": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "confirmed": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceId", "excerpt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": {
          "type": "string",
          "enum": [
            "main_answer",
            "follow_up_answer",
            "upload",
            "human_correction",
            "chat_message"
          ]
        },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploadId",
        "name",
        "status",
        "processedCharacters",
        "limitation"
      ],
      "properties": {
        "uploadId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed"]
        },
        "processedCharacters": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "limitation": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        }
      }
    },
    "flowId": {
      "type": "string",
      "pattern": "^(start|end|step-[1-9]\\d*|xor-[1-9]\\d*|edge-[1-9]\\d*)$"
    },
    "startEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "const": "start" },
        "kind": { "const": "startEvent" }
      }
    },
    "stepNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "stepId"],
      "properties": {
        "id": { "type": "string", "pattern": "^step-[1-9]\\d*$" },
        "kind": { "const": "step" },
        "stepId": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "gatewayNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "question", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^xor-[1-9]\\d*$" },
        "kind": { "const": "gateway" },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "mode": {
          "type": "string",
          "enum": ["rule_based", "professional_judgement", "mixed", "unknown"]
        }
      }
    },
    "endEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "const": "end" },
        "kind": { "const": "endEvent" }
      }
    },
    "flowNode": {
      "oneOf": [
        { "$ref": "#/$defs/startEvent" },
        { "$ref": "#/$defs/stepNode" },
        { "$ref": "#/$defs/gatewayNode" },
        { "$ref": "#/$defs/endEvent" }
      ]
    },
    "flowEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string", "pattern": "^edge-[1-9]\\d*$" },
        "source": { "$ref": "#/$defs/flowId" },
        "target": { "$ref": "#/$defs/flowId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "determination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "consequence": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/flowNode" }
        },
        "edges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/flowEdge" }
        }
      }
    }
  }
}
