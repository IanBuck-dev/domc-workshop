{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims-ai/process-follow-ups/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["previousQuestionReviews", "followUps"],
  "properties": {
    "previousQuestionReviews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "topicId", "outcome", "rationale"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1 },
          "topicId": {
            "type": "string",
            "enum": [
              "purpose-scope",
              "flow-roles",
              "information-systems",
              "decisions-controls-handoffs",
              "effort-pain-goals"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": ["addressed", "not_addressed"]
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "followUps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topicId", "question", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topicId": {
            "type": "string",
            "enum": [
              "purpose-scope",
              "flow-roles",
              "information-systems",
              "decisions-controls-handoffs",
              "effort-pain-goals"
            ]
          },
          "question": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
